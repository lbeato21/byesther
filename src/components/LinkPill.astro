---
import Icon from './Icon.astro';

interface Props {
  href: string;
  iconClass: string;
  text: string;
  variant: string;
  showArrow?: boolean;
}

const { href, iconClass, text, variant, showArrow = false } = Astro.props;
---
<a
  href={href}
  target="_blank"
  class={`flex items-center py-[16px] px-[20px] bg-glass-pill-bg border border-glass-border rounded-[50px] no-underline text-text-main text-[0.95rem] font-medium transition-all duration-300 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] relative overflow-hidden active:scale-[0.96] active:translate-y-[1px] ${variant}`}
>
  <Icon icon={iconClass} class="w-[22px] mr-[12px] transition-transform duration-300 ease" />
  <span>{text}</span>
  {showArrow && <Icon icon="fas fa-chevron-right" class="w-[12px] ml-auto opacity-50" />}
</a>
