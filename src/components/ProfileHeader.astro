---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
---
<header class="text-center mb-[25px]">
  <div class="w-[80px] h-[80px] bg-white rounded-full flex justify-center items-center mx-auto mb-[15px] shadow-[0_5px_15px_rgba(0,0,0,0.05)] border-2 border-white overflow-hidden">
    <Image
      src={logoImg}
      alt="Esther Crafts Logo"
      width={40}
      height={40}
      loading="eager"
      fetchpriority="high"
      class="w-[40px] h-[40px] object-contain"
    />
  </div>
  <h1 class="text-[1.4rem] font-bold tracking-[-0.5px] text-text-main mb-[3px]">Esther Crafts</h1>
  <p class="text-[0.8rem] text-text-muted font-normal tracking-[0.5px]">Artesanía Digital • Flores • Accesorios</p>
</header>
