---
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
  icon: string;
  class?: string;
  ariaHidden?: boolean;
}

const { icon, class: className, ariaHidden = true } = Astro.props;

// Map FontAwesome classes to Iconify names used by astro-icon
const iconMap: Record<string, string> = {
  'fas fa-globe': 'fa6-solid:globe',
  'fas fa-palette': 'fa6-solid:palette',
  'fas fa-bag-shopping': 'fa6-solid:bag-shopping',
  'fas fa-map-location-dot': 'fa6-solid:map-location-dot',
  'fab fa-whatsapp': 'fa6-brands:whatsapp',
  'fab fa-instagram': 'fa6-brands:instagram',
  'fas fa-chevron-right': 'fa6-solid:chevron-right',
};

const iconName = iconMap[icon] || icon;
---

<AstroIcon name={iconName} class={className} aria-hidden={ariaHidden} />
