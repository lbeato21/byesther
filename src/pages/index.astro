---
import Layout from '../layouts/Layout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import LinkPill from '../components/LinkPill.astro';
import SocialGroup from '../components/SocialGroup.astro';
import {
	siteConfig,
	primaryLink,
	instagramLinks,
	mapsLink,
	whatsappLink,
} from '../data/links';
---

<Layout title={siteConfig.pageTitle} description={siteConfig.description}>
	<ProfileHeader
		brandName={siteConfig.brandName}
		subtitle={siteConfig.subtitle}
	/>

	<nav aria-label="Enlaces oficiales de Esther Crafts" class="w-full flex flex-col gap-[12px]">
		<LinkPill {...primaryLink} />

		<SocialGroup title={siteConfig.instagramGroupTitle}>
			{instagramLinks.map((link) => <LinkPill {...link} />)}
		</SocialGroup>

		<LinkPill {...mapsLink} />

		<LinkPill {...whatsappLink} />
	</nav>

	<footer class="mt-[25px] text-[0.65rem] text-text-muted opacity-60 tracking-[2px] uppercase flex items-center gap-[5px]">
		<span class="font-bold text-neon-pink">{siteConfig.footerCredit.symbol}</span> {siteConfig.footerCredit.label}
	</footer>
</Layout>
